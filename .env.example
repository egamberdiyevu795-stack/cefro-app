# Copy to .env.local and fill in. Never commit real keys.
# All variables are read server-side only (src/server/config/env.ts).

# ── Database and recordings ──────────────────────────────
# Local development: leave the two TURSO_* variables unset. The app then uses a SQLite file (created and migrated
# automatically on first request) and stores recordings on disk.
DATABASE_PATH=./data/cefro.db
AUDIO_STORAGE_DIR=./data/audio
# Hosted (Vercel): set BOTH, in the Vercel project settings only (never in the repository, never NEXT_PUBLIC_*).
# The app then uses the hosted libSQL database over HTTPS, and keeps recordings in that same database, so every
# function instance sees the same data. Setting only one of the two is a configuration error.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Timeout for one request to the hosted database (ms).
# DATABASE_TIMEOUT_MS=15000
# Where recordings are stored: "auto" (default: database when Turso is configured, local disk otherwise),
# "database" or "local". "local" is refused on Vercel.
# AUDIO_STORAGE_PROVIDER=auto
# A Vercel Preview or Development environment (VERCEL_ENV=preview|development, e.g. after `vercel env pull`) refuses to
# connect to Turso, so it can never touch the production database. Set to "true" ONLY if those environments have their
# own, separate Turso database. Plain local development (no VERCEL_ENV) is not affected.
# CEFRO_ALLOW_PREVIEW_TURSO=true
# The hosted database is migrated explicitly with `npm run db:migrate` (never by the Vercel build); local files migrate on open.

# ── Speech-to-text ───────────────────────────────────────
# "openai" (real), "gemini" (real, TEMPORARY: uses GEMINI_API_KEY; invents words on silent audio, see
# docs/AI_EVALUATION_QUALITY.md) or "mock" (development only: returns a canned transcript, ignores audio).
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
# Validate with real learner speech (npm run eval:transcription) before changing.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
# Second provider, tried only when the first fails (timeout, rate limit, outage); never for "no speech".
# "none" (default), "openai" or "gemini". Example switch: TRANSCRIPTION_PROVIDER=gemini + TRANSCRIPTION_FALLBACK_PROVIDER=openai.
# TRANSCRIPTION_FALLBACK_PROVIDER=none
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_TIMEOUT_MS=90000

# ── Speech Activity Guard ────────────────────────────────
# Recordings without enough speech are stopped before any transcription provider is called. "auto" = on for real
# providers, off for the development mock. Needs ffmpeg when on (the server refuses to start in production without it).
# SPEECH_GUARD=auto
# FFMPEG_PATH=ffmpeg

# ── AI evaluation ────────────────────────────────────────
# "gemini" or "anthropic" (real), or "mock" (development only: heuristic, clearly labelled in the UI).
# Only the selected provider's key is needed.
EVALUATION_PROVIDER=anthropic

# Gemini (official @google/genai SDK) — variable names only; never commit a real key.
GEMINI_API_KEY=
# Pinned default (verified against the live API). The model that actually answered is stored per evaluation.
# Avoid moving aliases such as gemini-flash-latest; re-run the live validation when you change this.
# GEMINI_EVALUATION_MODEL=gemini-3.8-flash
# GEMINI_EVALUATION_MAX_TOKENS=24000
# minimal | low | medium | high (default: high; only for models that support thinking levels).
# GEMINI_THINKING_LEVEL=high
# GEMINI_TEMPERATURE=0
# "schema" (default) sends the JSON schema to the API; "json" only asks for JSON (use if the API rejects the schema).
# GEMINI_STRUCTURED_OUTPUT=schema

# Audio step of the Multilevel evaluation: Gemini listens to the recording and judges pronunciation (intelligibility,
# listener strain; never accent) and pausing. "auto" (default) = on when GEMINI_API_KEY is set and the evaluator is
# not the mock; "gemini" = always (needs GEMINI_API_KEY); "off" = pronunciation "not assessed", every band provisional.
# AUDIO_ASSESSMENT=auto
# GEMINI_AUDIO_ASSESSMENT_MODEL=gemini-3.8-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_EVALUATION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — assessment quality is sensitive to this; measure before lowering.
ANTHROPIC_EVALUATION_EFFORT=high
# ANTHROPIC_EVALUATION_MAX_TOKENS=16000
# Server-side refusal fallback (beta). Set to false if your account rejects the beta header.
# ANTHROPIC_SERVER_FALLBACKS=true
# EVALUATION_TIMEOUT_MS=180000

# ── Usage limits and processing budget (server-enforced; defaults shown) ─────────────
# Rationale: docs/ARCHITECTURE_DECISIONS.md, sections 5 and 7.
# LIMIT_ATTEMPTS_PER_USER_HOUR=15
# LIMIT_ATTEMPTS_PER_USER_DAY=60
# LIMIT_CONCURRENT_PROCESSING_PER_USER=2
# Total new attempts per hour for everyone: set this from your provider budget.
# LIMIT_ATTEMPTS_GLOBAL_HOUR=600
# Processing runs per attempt (first run + restarts).
# LIMIT_PROCESSING_RUNS_PER_ATTEMPT=3
# Wall-clock budget for one run (10000-290000 ms); must stay below the route maxDuration (300 s).
# PROCESSING_BUDGET_MS=270000

# ── Accounts (sign-in) ───────────────────────────────────
# Signs the login-session cookie. REQUIRED in production: 32+ random characters, e.g. `openssl rand -base64 48`.
# Development and tests use a fixed public fallback, so never rely on it outside your machine.
AUTH_SECRET=
# The public https origin of the app (required in production; used for the sign-in origin check).
# APP_URL=https://app.example.com
# Abuse limits for sign-in and registration (in-memory, per process; defaults shown).
# LIMIT_LOGIN_FAILURES_PER_EMAIL_15MIN=8
# LIMIT_LOGIN_FAILURES_PER_IP_15MIN=30
# LIMIT_REGISTRATIONS_PER_IP_HOUR=10
# LIMIT_REGISTRATIONS_GLOBAL_HOUR=100


# ── Vercel deployment (docs/DEPLOY_VERCEL.md) ───────────
# Set in the Vercel project settings, never in the repository:
#   GEMINI_API_KEY, TRANSCRIPTION_PROVIDER=gemini, EVALUATION_PROVIDER=gemini, AUTH_SECRET (32+ random characters),
#   TURSO_DATABASE_URL, TURSO_AUTH_TOKEN
# APP_URL is derived from the platform's VERCEL_* variables. FFMPEG_PATH is optional: without it the guard uses ffmpeg
# from PATH, else the ffmpeg-static binary.
