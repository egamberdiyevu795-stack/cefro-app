# Copy to .env.local and fill in. Never commit real keys.
# All variables are read server-side only (src/server/config/env.ts).

# ── Storage ──────────────────────────────────────────────
# SQLite database file (created and migrated automatically on first request).
DATABASE_PATH=./data/cefro.db
# Where recorded audio is stored. Only "local" exists today.
AUDIO_STORAGE_PROVIDER=local
AUDIO_STORAGE_DIR=./data/audio

# ── Speech-to-text ───────────────────────────────────────
# "openai" (real) or "mock" (development only: returns a canned transcript, ignores audio).
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_TIMEOUT_MS=90000

# ── AI evaluation ────────────────────────────────────────
# "anthropic" (real) or "mock" (development only: heuristic, clearly labelled in the UI).
EVALUATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_EVALUATION_MODEL=claude-opus-5-5
# EVALUATION_TIMEOUT_MS=180000
