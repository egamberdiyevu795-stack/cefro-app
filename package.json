{
  "name": "cefro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "check": "npm run lint && npm run typecheck && npm run test",
    "eval:live": "node scripts/eval-live.mjs",
    "eval:live:part2": "EVAL_SAMPLES=A,S15 node scripts/eval-live.mjs",
    "eval:live:new-tasks": "EVAL_SAMPLES=NEW node scripts/eval-live.mjs",
    "eval:transcription": "vitest run --config vitest.live.config.mts test/live/transcription.live.test.ts",
    "stats": "node scripts/processing-stats.mjs",
    "test:e2e": "playwright test",
    "test:e2e:part3": "playwright test -c playwright.part3.config.ts && E2E_P3_VARIANT=nokey playwright test -c playwright.part3.config.ts",
    "test:e2e:preview": "next build && playwright test -c playwright.preview.config.ts",
    "eval:transcription:controlled": "vitest run --config vitest.live.config.mts test/live/transcription-validation.live.test.ts",
    "eval:pipeline": "vitest run --config vitest.live.config.mts test/live/full-pipeline.live.test.ts",
    "test:e2e:exam-laptop": "playwright test -c playwright.exam-laptop.config.ts",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "vercel-build": "next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.26.0",
    "@libsql/client": "^0.18.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "ffmpeg-static": "^5.3.0",
    "next": "16.3.8",
    "nodemailer": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
